# Copy to .env (git-ignored) and fill in. Never commit real values.

# Rust API: read-only PostgreSQL login (pooled URL with sslmode=require when hosted)
DATABASE_URL_READONLY=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Rust API: live analysis on the worker (worker/), reached through a tunnel. Leave empty = live offline.
WORKER_URL=
WORKER_TOKEN=
# Optional: require this code to start live analysis. Empty = public (one session at a time).
LIVE_ACCESS_CODE=
